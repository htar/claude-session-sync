{
  "name": "claude-session-sync",
  "displayName": "Session Sync for Claude Code",
  "description": "Continue a Claude Code session on another device. Sync your session history through GitHub, iCloud Drive, Dropbox, OneDrive, Google Drive and more, and choose which sessions to bring over.",
  "version": "0.12.0",
  "publisher": "tkhmelovskyi",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/htar/claude-session-sync.git"
  },
  "homepage": "https://github.com/htar/claude-session-sync#readme",
  "bugs": {
    "url": "https://github.com/htar/claude-session-sync/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "sync",
    "sessions",
    "icloud",
    "dropbox",
    "onedrive",
    "google drive",
    "github"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reads and writes ~/.claude and runs git."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeSessionSync.push",
        "title": "%command.push.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.pull",
        "title": "%command.pull.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.chooseMode",
        "title": "%command.chooseMode.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.deleteExport",
        "title": "%command.deleteExport.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.manage",
        "title": "%command.manage.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.enableEncryption",
        "title": "%command.enableEncryption.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.showLog",
        "title": "%command.showLog.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.disconnect",
        "title": "%command.disconnect.title%",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.resume",
        "title": "%command.resume.title%",
        "category": "Claude Sync"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "claudeSessionSync.mode": {
          "type": "string",
          "enum": [
            "",
            "github",
            "dropbox",
            "onedrive",
            "googledrive",
            "folder",
            "git"
          ],
          "enumDescriptions": [
            "%config.mode.enum0%",
            "%config.mode.enum1%",
            "%config.mode.enum2%",
            "%config.mode.enum3%",
            "%config.mode.enum4%",
            "%config.mode.enum5%",
            "%config.mode.enum6%"
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.mode.description%"
        },
        "claudeSessionSync.syncFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.syncFolder.description%"
        },
        "claudeSessionSync.deviceName": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.deviceName.description%"
        },
        "claudeSessionSync.repoUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.repoUrl.description%"
        },
        "claudeSessionSync.claudeDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.claudeDir.description%"
        },
        "claudeSessionSync.maxFileSizeMB": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 95,
          "scope": "machine",
          "markdownDescription": "%config.maxFileSizeMB.description%"
        },
        "claudeSessionSync.maxSessionAgeDays": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "%config.maxSessionAgeDays.description%"
        },
        "claudeSessionSync.scanSecrets": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "%config.scanSecrets.description%"
        },
        "claudeSessionSync.projectKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.projectKey.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check --end-of-line auto .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "tsc -p tsconfig.test.json && node --test out/test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run build:prod && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
