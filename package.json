{
  "name": "claude-session-sync",
  "displayName": "Session Sync for Claude Code",
  "description": "Continue a Claude Code session on another device: syncs transcripts through your own private git repository.",
  "version": "0.3.0",
  "publisher": "tkhmelovskyi",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/htar/claude-session-sync.git"
  },
  "homepage": "https://github.com/htar/claude-session-sync#readme",
  "bugs": {
    "url": "https://github.com/htar/claude-session-sync/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "sync",
    "sessions"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reads and writes ~/.claude and runs git."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeSessionSync.push",
        "title": "Push sessions",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.pull",
        "title": "Pull sessions",
        "category": "Claude Sync"
      },
      {
        "command": "claudeSessionSync.resume",
        "title": "Resume a session",
        "category": "Claude Sync"
      }
    ],
    "configuration": {
      "title": "Session Sync for Claude Code",
      "properties": {
        "claudeSessionSync.repoUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "URL of a **private** git repository that stores the transcripts (`https://…`, `ssh://…` or `git@host:owner/repo.git`)."
        },
        "claudeSessionSync.claudeDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Claude config directory. Empty = `~/.claude`."
        },
        "claudeSessionSync.maxFileSizeMB": {
          "type": "number",
          "default": 90,
          "minimum": 1,
          "maximum": 95,
          "scope": "machine",
          "markdownDescription": "Sessions bigger than this are **not pushed** (and are reported). GitHub rejects any file over 100 MB, and one such file fails the whole push."
        },
        "claudeSessionSync.maxSessionAgeDays": {
          "type": "integer",
          "default": 30,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "Push only sessions modified within this many days. `0` = no limit. A pull always takes everything the repository holds."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --sourcemap --outfile=dist/extension.js",
    "build:prod": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --minify --outfile=dist/extension.js",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "tsc -p tsconfig.test.json && node --test out/test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run build:prod && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
